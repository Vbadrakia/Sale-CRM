NODE_ENV=development
PORT=5000

# --- Supabase & PostgreSQL ------------------------------------------------
SUPABASE_URL=https://ldoguxshqloenecefngs.supabase.co
SUPABASE_ANON_KEY=sb_publishable_LYYU5L6xBVCTPER4Z9sYKw___3l8zBP
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgres://postgres.ldoguxshqloenecefngs:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Auth -----------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# --- SMTP (OTP + password reset + welcome emails) -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CRM <no-reply@example.com>"

# --- OTP / password reset -------------------------------------------------
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRES_MINUTES=30

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=10

# --- URLs / CORS ----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# --- Background jobs ------------------------------------------------------
ENABLE_JOBS=true
FOLLOWUP_REMINDER_LEAD_MINUTES=60
