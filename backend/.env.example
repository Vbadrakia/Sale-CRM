# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crm
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=crm
DB_USER=postgres
DB_PASSWORD=postgres
# Database SSL / TLS Configuration
DB_SSL=false
# DB_CA_CERT: PEM string of your database root CA (e.g. Supabase root CA from Dashboard -> Database -> SSL). Supports escaped newlines (\n).
# DB_SSL_CA: Alias for DB_CA_CERT.
# DB_CA_CERT=
# DB_SSL_REJECT_UNAUTHORIZED: DEV ONLY. Enforces strict TLS verification. Ignored and strictly rejected as a startup error if set to false when NODE_ENV=production.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Supabase (Optional if using direct PostgreSQL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication (Generate a cryptographically secure 32+ char secret in production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS & URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# SMTP Configuration (Optional for development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CRM <no-reply@example.com>

# Security Limits
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRES_MINUTES=30
UPLOAD_MAX_FILE_SIZE_MB=10

# Background Jobs
ENABLE_JOBS=true
FOLLOWUP_REMINDER_LEAD_MINUTES=60
